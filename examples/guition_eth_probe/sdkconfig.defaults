CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_EXAMPLE_ETH_PHY_INTERFACE_RMII=y
CONFIG_EXAMPLE_ETH_RMII_CLK_INPUT=y
CONFIG_EXAMPLE_ETH_RMII_CLK_GPIO=50
CONFIG_EXAMPLE_ETH_MDC_GPIO=31
CONFIG_EXAMPLE_ETH_MDIO_GPIO=52
CONFIG_EXAMPLE_ETH_PHY_ADDR=-1
CONFIG_EXAMPLE_ETH_PHY_RST_GPIO=51
CONFIG_EXAMPLE_ETH_RMII_TX_EN_GPIO=49
CONFIG_EXAMPLE_ETH_RMII_TXD0_GPIO=34
CONFIG_EXAMPLE_ETH_RMII_TXD1_GPIO=35
CONFIG_EXAMPLE_ETH_RMII_CRS_DV_GPIO=28
CONFIG_EXAMPLE_ETH_RMII_RXD0_GPIO=29
CONFIG_EXAMPLE_ETH_RMII_RXD1_GPIO=30
