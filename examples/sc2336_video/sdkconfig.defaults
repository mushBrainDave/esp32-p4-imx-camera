# Wireless-Tag WT9932P4-TINY (WT0132P4-A1 module, ESP32-P4 rev v3.2) with the
# WTDK-CAM-2336 camera sold for it.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM - capture buffers and the recorded clip. Same settings as the vendor's
# own CSI example. 200 MHz is gated behind the experimental-features flag.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# Console on the chip's USB-Serial/JTAG (the FUSB port); there is no UART
# bridge on this board. tools/capture.py detects the port type and resets the
# board accordingly.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# esp_video: MIPI-CSI capture + ISP pipeline (AE/AWB from the SC2336 tuning file)
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# Sensor: the mode the vendor ships, 1024x600 RAW8 at 30 fps over 2 lanes.
CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_SC2336_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC2336_MIPI_RAW8_1024X600_30FPS=y
CONFIG_CAMERA_SC2336_MIPI_DEFAULT_FMT_RAW8_1024X600_30FPS=y
CONFIG_CAMERA_SC2336_DEFAULT_IPA_JSON_CONFIGURATION_FILE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
