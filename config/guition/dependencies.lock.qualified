  espressif/esp_video:
    component_hash: 5694b16c12b8bb26b56ad3f999ad10119f1314d64b2d1c518bc7dfed902df9e1
    dependencies:
    - name: espressif/cmake_utilities
      registry_url: https://components.espressif.com
      require: private
      version: 0.*
    - name: espressif/esp_cam_sensor
      registry_url: https://components.espressif.com
      require: private
      version: 2.6.*
    - matches:
      - if: $CONFIG{ESP_VIDEO_USE_CUSTOMIZED_ESP_H264_VERSION} == False
      name: espressif/esp_h264
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: target in [esp32p4]
      version: 1.4.*
    - name: espressif/esp_ipa
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: target in [esp32p4]
      version: 2.4.*
    - name: idf
      require: private
      version: '>=5.4'
    - name: espressif/usb_host_uvc
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: target in [esp32p4, esp32s3, esp32s31]
      version: 2.5.*
    source:
      registry_url: https://components.espressif.com/
      type: service
    targets:
    - esp32p4
    - esp32s3
    - esp32c3
    - esp32c5
    - esp32c6
    - esp32c61
    - esp32s31
    version: 2.5.0
  espressif/media_lib_sal:
