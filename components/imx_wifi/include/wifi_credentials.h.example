/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Copy this file to `wifi_credentials.h` beside it and fill it in.
 *
 * `wifi_credentials.h` is in .gitignore. Keep it that way - a WiFi PSK in git
 * history is not removable by a later commit. Examples build and flash without
 * this file; they just refuse to connect and say so, so a missing credential is
 * a clear runtime message rather than a build error.
 *
 * After creating this file for the first time, run `idf.py fullclean`. It is
 * included behind __has_include, so ninja has no dependency on a file that did
 * not exist at the last build and will happily reuse an object compiled
 * without it.
 *
 * The C6 is a 2.4 GHz-only radio. A 5 GHz-only SSID will not be found.
 */
#pragma once

#define WIFI_STA_SSID     "your-network"
#define WIFI_STA_PASSWORD "your-password"
